olor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <h3 class=\"mbr-section-title mbr-fonts-style mb-3 pd-02\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Tưởng Thưởng &amp; Ghi Nhận: Đáp Ứng Sự Đa Dạng Hóa và Giữ Chân Nhân Tài</b></h3>\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/viettel-story-11.jpg\" alt>\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\"><b>\n                        Viettel Stars</b></p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Viettel đối mặt với các thách thức của thị trường cạnh tranh, ngân sách hạn chế, cân bằng nội bộ và kỳ vọng đa dạng của tài năng bằng cách cung cấp một loạt các chương trình Khen Thưởng &amp; Ghi Nhận. Trong đó, Viettel DX Excellence và Viettel Future Leader là các giải pháp hàng đầu, tập trung vào việc cung cấp các phần thưởng đặc biệt thông qua quỹ học bổng để bù đắp và giữ chân những người có thành tích cao và tài năng chủ chốt, cho phép họ phát triển và nâng cao kỹ năng.</p>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Ngoài ra, công ty cũng cung cấp các khoản thưởng dựa trên hiệu suất và mức tăng lương cơ bản các đơn vị kinh doanh và lĩnh vực khác nhau. Các chương trình như Idea Initiative và Viettel Stars được tổ chức thường xuyên để ghi nhận những đóng góp xuất sắc của những cá nhân có thành tích nổi bật, nuôi dưỡng một văn hóa đổi mới và xuất sắc.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
