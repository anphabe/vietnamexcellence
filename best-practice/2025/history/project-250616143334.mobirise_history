color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/25highlands-story-10.jpg\" alt>\n                    <p class=\"mbr-description mbr-fonts-style pt-2 align-center\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-description\"><i>\n                    Highlands Bến Vân Đồn (Quận 4)</i></p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Điển hình, trong không gian cửa hàng Highlands Saigon Central Post Office cũng là nơi được Ban lãnh đạo đầu tư truyền cảm hứng mạnh mẽ về sự đam mê, sáng tạo trên nền nguyên liệu cà phê và trà đặc sản của Việt Nam đến cộng đồng người Việt và du khách quốc tế.<br><br>Việc tôn vinh bản sắc văn hoá tại Highlands không chỉ dừng lại ở thiết kế cửa hàng. Từng chi tiết nội thất được chăm chút tỉ mỉ, mang đậm họa tiết truyền thống Việt Nam, từng lời chào thân tình, gần gũi từ đội ngũ nhân viên đều gợi nhắc đến sự ấm áp của người Việt. Mỗi yếu tố đều được tạo nên để kết nối con người với những lát cắt sống động của văn hoá Việt. Cam kết gìn giữ cội nguồn văn hoá ấy được thể hiện rõ nét qua từng ly cà phê, từng cử chỉ phục vụ, tất cả hoà quyện trong triết lý “Cup of love” mà Highlands luôn theo đuổi.&nbsp;<br> </p>\n\n                </div>           \n            </div>\n        </div>\n    </div>\n</section>",
