ype !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/25abinbev-story-1.jpg\" alt>\n                    <p class=\"mbr-description mbr-fonts-style mt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                        Image Description</p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Đằng sau sự vươn mình mạnh mẽ của AB InBev là sự thúc đẩy không ngừng của ông Craig MacLean – Chủ tịch kiêm Tổng Giám đốc Điều hành Khu vực Kinh doanh Đông Nam Á. Với hơn 15 năm kinh nghiệm tại thị trường Châu Á – Thái Bình Dương, ông Craig đã trở thành người truyền cảm hứng cho một tư duy lãnh đạo mới, từ mô hình phân cấp sang trao quyền, từ kiểm soát sang kiến tạo văn hóa, từ chỉ đạo sang truyền cảm hứng. Triết lý lãnh đạo của ông được đúc kết trong ba từ: <b>Đơn giản – Linh hoạt – Mỗi ngày tốt hơn 1%</b>. </p>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
