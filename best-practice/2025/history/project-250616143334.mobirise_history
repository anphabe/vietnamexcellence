pe !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/25schneiderelectric-story-9.jpg\" alt>\n                    <p class=\"mbr-description mbr-fonts-style pt-2 align-center\" mbr-theme-style=\"display-4\" mbr-if=\"showDescription\" data-app-selector=\".mbr-description\">\n                    Image Description</p>\n                </div>\n            </div>\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Tại Schneider Electric, tư duy “Skill-first” không chỉ dừng lại ở việc đào tạo mà còn tập trung vào chiến lược xây dựng năng lực sẵn sàng cho tương lai. Từ chương trình mentorship đảo chiều, kỹ năng số cho đến hành động hóa phát triển bền vững, Schneider trang bị cho nhân viên ở mọi cấp độ kiến thức và sự tự tin để làm chủ sự chuyển đổi. Bằng việc đầu tư vào những kỹ năng thực tiễn, Schneider đảm bảo lực lượng lao động luôn vững vàng, linh hoạt và nắm bắt kịp xu thế. Chính sự kết hợp chặt chẽ giữa văn hóa và năng lực này đã giúp Schneider nuôi dưỡng những nhà lãnh đạo toàn diện, mà còn truyền cảm hứng về mục tiêu và khả năng thích ứng cho cả đội ngũ.&nbsp;<br><br>Reverse Mentoring là nơi những nhân viên trẻ chia sẻ góc nhìn và dẫn dắt các lãnh đạo cấp cao về những chủ đề như sức khỏe tinh thần, trí tuệ nhân tạo hay cả TikTok. Mô hình học hỏi hai chiều này giúp đội ngũ lãnh đạo luôn gần gũi, thức thời và thích nghi linh hoạt trong một thế giới chuyển động không ngừng.&nbsp;<br></p>\n\n                </div>           \n            </div>\n        </div>\n    </div>\n</section>",
